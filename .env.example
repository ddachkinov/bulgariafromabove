# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bulgaria_from_above"

# Authentication
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Storage (DigitalOcean Spaces or AWS S3)
S3_BUCKET="bulgaria-photos"
S3_REGION="nyc3"
S3_ENDPOINT="https://nyc3.digitaloceanspaces.com"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"

# Maps (optional - using Leaflet by default)
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token"

# API
API_URL="http://localhost:4000"
JWT_SECRET="your-jwt-secret"

# Email (optional for MVP)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"

# Admin
ADMIN_EMAIL="admin@bulgariafromabove.com"
